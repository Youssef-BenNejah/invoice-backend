# -- App --
APP_PORT=8080
APP_ENV=dev
FRONTEND_URL=https://invoxa.netlify.app

# -- MongoDB (local, no external hosting) --
DB_NAME=invoxa
DB_HOST=localhost
DB_PORT=27019

# -- JWT - RS256 Keys (base64-encoded) --
# Generate:
#   openssl genrsa -out private.pem 2048
#   openssl rsa -in private.pem -pubout -out public.pem
#   base64 -w 0 private.pem   ->  paste as JWT_PRIVATE_KEY
#   base64 -w 0 public.pem    ->  paste as JWT_PUBLIC_KEY
JWT_PRIVATE_KEY=<base64_encoded_RSA_private_key>
JWT_PUBLIC_KEY=<base64_encoded_RSA_public_key>
JWT_ACCESS_TOKEN_EXPIRY_MS=900000
JWT_REFRESH_TOKEN_EXPIRY_MS=604800000

# -- Security --
BCRYPT_STRENGTH=12
ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_DURATION_MINUTES=30

# -- Actuator --
ACTUATOR_USERNAME=admin
ACTUATOR_PASSWORD=securepassword

# -- Mail (SMTP) --
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=<smtp_username>
SPRING_MAIL_PASSWORD=<smtp_app_password>
SPRING_MAIL_SMTP_AUTH=true
SPRING_MAIL_SMTP_STARTTLS_ENABLE=true
MAIL_FROM_NAME=Invoxa

# -- Seed admin (created on first startup if no ADMIN user exists) --
SEED_ADMIN_EMAIL=admin@invoxa.tn
SEED_ADMIN_PASSWORD=<strong_password>

# -- Desktop sync client (leave SYNC_ENABLED unset/false here — this block only matters in the
# desktop build's bundled .env, where it points at this cloud deployment once it's actually
# hosted somewhere reachable) --
SYNC_ENABLED=false
SYNC_CLOUD_BASE_URL=<https://your-deployed-backend>
# A dedicated account for the desktop's background sync job — not a real staff login.
SYNC_CLOUD_EMAIL=<sync_service_account_email>
SYNC_CLOUD_PASSWORD=<sync_service_account_password>
SYNC_POLL_INTERVAL_MS=30000
